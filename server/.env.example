# Black Area server — điền thông tin Aiven MySQL (Aiven Console > service > Overview > Connection information)
PORT=8787

DB_HOST=
DB_PORT=
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb

# Aiven bắt buộc SSL. Tải "CA certificate" (ca.pem) từ Aiven rồi chọn MỘT trong hai cách:
#  1) đường dẫn file (chạy local)
DB_CA_CERT_PATH=./ca.pem
#  2) dán nội dung PEM trên 1 dòng, xuống dòng thay bằng \n (dùng trên Render/hosting)
DB_CA_CERT=
# DB_SSL=false  # chỉ khi DB không dùng SSL

# Tuỳ chọn
SAVE_TABLE=saves
SAVE_MAX_BYTES=20971520
# Nếu đặt, client phải gửi header x-api-key
SAVE_API_KEY=
# Domain web game được phép gọi API (vd https://black-area.vercel.app); * = mọi nơi
CORS_ORIGIN=*
DB_POOL_SIZE=5
