# Copy to .env.local (not committed) to change local dev settings.
# Demo game: skip the faction screen and play alone, finances off.
VITE_DEMO_MODE=false
# Demo nation: 1 USA, 2 Russia, 3 China, 4 Europe, 5 Islamic
VITE_DEMO_FACTION=2
# Multiplayer server (../server): local default ws://localhost:8787, on Render wss://<service>.onrender.com
VITE_SERVER_URL=ws://localhost:8787
