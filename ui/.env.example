# Copy to .env.local (not committed) to change local dev settings.
# Demo game: skip the faction screen and play alone, finances off.
VITE_DEMO_MODE=false
# Demo nation: us USA, ru Russia, cn China, eu Europe, ui Islamic union
VITE_DEMO_FACTION=ru
# Multiplayer server (../server). Unset: http://localhost:8787 in dev, https://black-area.onrender.com in a build.
VITE_GAME_SERVER_API=https://black-area.onrender.com
